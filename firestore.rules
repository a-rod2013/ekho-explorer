rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The author of the post, looked up from the post document.
    function isPostAuthor(postId) {
      return signedIn()
        && get(
          /databases/$(database)/documents/posts/$(postId)
        ).data.userId == request.auth.uid;
    }

    // Accounts

    function validProfile(d) {
      return d.keys().hasOnly([
          'username',
          'usernameLower',
          'createdAt'
        ])
        && d.username is string
        && d.username.size() >= 3
        && d.username.size() <= 20
        && d.username.matches('[A-Za-z0-9_.]+')
        && d.usernameLower == d.username.lower()
        && d.createdAt == request.time;
    }

    match /users/{userId} {
      // Anyone signed in can look up one profile, but not list them all.
      allow get: if signedIn();

      allow create: if isUser(userId)
        && validProfile(request.resource.data);

      allow update: if isUser(userId)
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["bio"])
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160;

      allow delete: if false;

      // Profile Avatars
      match /avatar/{avatarId} {

        // Signed-in user can view an avatar
        allow get: if signedIn()
            && avatarId == 'current';

        // Only the account owner can upload or replace their avatar
        allow create, update: if isUser(userId)
            && avatarId == 'current'
            && request.resource.data.keys().hasAll([
                'data',
                'width',
                'height'
            ])
            && request.resource.data.keys().hasOnly([
                'data',
                'width',
                'height'
            ])
            && request.resource.data.data is bytes
            && request.resource.data.data.size() > 0
            && request.resource.data.data.size() <= 100000
            && request.resource.data.width is int
            && request.resource.data.width > 0
            && request.resource.data.width <= 2048
            && request.resource.data.height is int
            && request.resource.data.height > 0
            && request.resource.data.height <= 2048;

            allow delete: if false;
      }

      // Notifications
      match /notifications/{notificationId} {
        allow read: if isUser(userId);

        allow create: if signedIn()
          && request.resource.data.actorId == request.auth.uid;

        allow update, delete: if isUser(userId)
          || (
            signedIn()
            && resource.data.actorId == request.auth.uid
          );
      }
    }

    // Feed

    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      // Voting and commenting change these counters.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'upCount',
            'downCount',
            'commentCount'
          ]);

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      match /photos/{position} {
        allow read: if signedIn();

        allow create: if signedIn()
          && position in ['0', '1', '2', '3', '4']
          && getAfter(
            /databases/$(database)/documents/posts/$(postId)
          ).data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'data',
            'width',
            'height'
          ])
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 100000
          && request.resource.data.width is int
          && request.resource.data.height is int;

        allow update: if false;

        allow delete: if isPostAuthor(postId);
      }

      match /comments/{commentId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;

        allow update: if signedIn()
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'upCount',
              'downCount'
            ]);

        // The commenter or the post's author.
        allow delete: if signedIn()
          && (
            resource.data.userId == request.auth.uid
            || isPostAuthor(postId)
          );
      }
    }

    // votes/{postId}_{userId}

    match /votes/{voteId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && voteId.matches('.*_' + request.auth.uid)
        && request.resource.data.value in ['UP', 'DOWN'];

      // The voter or the post's author.
      allow delete: if signedIn()
        && (
          voteId.matches('.*_' + request.auth.uid)
          || isPostAuthor(resource.data.postId)
        );
    }

    // commentVotes/{commentId}_{userId}

    match /commentVotes/{voteId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && voteId.matches('.*_' + request.auth.uid)
        && request.resource.data.value in ['UP', 'DOWN'];

      allow delete: if signedIn()
        && (
          voteId.matches('.*_' + request.auth.uid)
          || isPostAuthor(resource.data.postId)
        );
    }

    // Blocked/hidden accounts

    match /userRelations/{relationId} {
      allow read: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      allow create, update: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // Private journal text and metadata

    match /users/{userId}/journalEntries/{entryId} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId;
      }

      function validEntry() {
        let data = request.resource.data;
        let fields = [
          'id',
          'ownerId',
          'title',
          'notes',
          'createdAtMillis',
          'updatedAtMillis',
          'revision',
          'deletedAtMillis',
          'syncedAt'
        ];

        return data.keys().hasAll(fields)
          && data.keys().hasOnly(fields)
          && data.id == entryId
          && data.ownerId == userId
          && data.title is string
          && data.notes is string
          && data.createdAtMillis is int
          && data.createdAtMillis >= 0
          && data.updatedAtMillis is int
          && data.updatedAtMillis >= data.createdAtMillis
          && data.revision is int
          && data.revision >= 1
          && (
            data.deletedAtMillis == null
            || (
              data.deletedAtMillis is int
              && data.deletedAtMillis >= 0
              && data.title == ''
              && data.notes == ''
            )
          )
          && data.syncedAt == request.time;
      }

      allow read: if isOwner();

      allow create: if isOwner()
        && validEntry();

      allow update: if isOwner()
        && validEntry()
        && request.resource.data.createdAtMillis
          == resource.data.createdAtMillis
        && request.resource.data.revision > resource.data.revision
        && resource.data.deletedAtMillis == null;

      // Deletion is represented by a revisioned tombstone.
      allow delete: if false;
    }

    // Anything not listed above is closed.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
